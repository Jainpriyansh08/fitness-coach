        {
          "label": "HOME  ·  floor space, a chair, a towel and a door",
          "style": "home",
          "prescription_labels": ["Week 1", "Week 2"],
          "exercises": [
            {
              "pattern": "Squat",
              "name": "Bodyweight squat (slow lowering)",
              "cues": "3 s down as low as comfortable, chest up, knees follow toes.",
              "prescription": ["3 × 10", "3 × 12–15"],
              "rest": "60 s",
              "easier": "Squat to chair",
              "harder": "2-s pause at the bottom",
              "if_bothers": "Higher seat",
              "video": "https://www.youtube.com/watch?v=DlS-GAF8Edg"
            },
            {
              "pattern": "Push",
              "name": "Incline push-up",
              "cues": "Hands on a sturdy edge, body straight, chest to the edge, push away.",
              "prescription": ["3 × 8", "3 × 10"],
              "rest": "60–90 s",
              "easier": "Higher surface",
              "harder": "Lower surface",
              "if_bothers": "Hands wider; stop if a shoulder pinches",
              "video": "https://www.youtube.com/watch?v=LkjSCxoyD2Y"
            },
            {
              "pattern": "Pull",
              "name": "Towel door row",
              "cues": "Stand on the side where the door opens away from you; lean back straight, pull chest to hands.",
              "prescription": ["3 × 8", "3 × 10–12"],
              "rest": "60–90 s",
              "easier": "Stand more upright",
              "harder": "Feet closer to the door",
              "if_bothers": "Stop if the door shifts",
              "video": "https://www.youtube.com/watch?v=HtTDy-2GNTE"
            },
            {
              "pattern": "Hinge",
              "name": "Glute bridge",
              "cues": "Squeeze glutes, lift until shoulders–hips–knees line up, lower slowly.",
              "prescription": ["3 × 12", "3 × 15 (2-s hold)"],
              "rest": "45 s",
              "easier": "Lift halfway",
              "harder": "Single-leg",
              "if_bothers": "Lift less high",
              "video": "https://www.youtube.com/watch?v=n6JiF2jp2Ns"
            },
            {
              "pattern": "Core",
              "name": "Dead bug",
              "cues": "Lower back gently down; lower opposite arm and leg slowly.",
              "prescription": ["2 × 6 each", "3 × 8 each"],
              "rest": "45 s",
              "easier": "Legs only",
              "harder": "Slower",
              "if_bothers": "Smaller range",
              "video": "https://www.youtube.com/watch?v=bxn9FBrt4-A"
            }
          ]
        }
      ]
